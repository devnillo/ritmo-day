# Copie para .env e ajuste. Nunca versione o .env com valores reais.

# --- Banco de dados ---
# Usuário, senha e nome do banco usados pelo container postgres.
POSTGRES_USER=ritmo
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=ritmo
# Porta do Postgres de desenvolvimento no host (compose.dev.yaml). Só escuta em 127.0.0.1.
POSTGRES_PORT=5440

# URL usada pelo app e pelo Prisma ao rodar fora do Docker (pnpm dev, testes).
# Dentro do Docker Compose a URL é montada a partir das variáveis acima.
DATABASE_URL=postgresql://ritmo:troque-esta-senha@localhost:5440/ritmo

# --- Aplicação ---
# Porta do app no host ao rodar a stack completa (compose.yaml).
# Na VPS, escolha uma porta livre: o app fica em http://IP_DA_VPS:WEB_PORT
WEB_PORT=3000

# --- Autenticação (Better Auth) ---
# Segredo para assinar cookies e tokens. Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=gere-um-segredo-com-openssl-rand-base64-32
# URL pública do app (links dos e-mails e checagem de origem/CSRF). Precisa ser EXATAMENTE o endereço
# aberto no navegador. Na VPS: http://IP_DA_VPS:WEB_PORT (ou https://seu-dominio quando houver).
BETTER_AUTH_URL=http://localhost:3000
# Verifica senhas vazadas no Have I Been Pwned (só o prefixo do hash sai do servidor).
# Se o serviço estiver fora do ar, o cadastro falha; desligue apenas em desenvolvimento offline.
PASSWORD_BREACH_CHECK=true

# --- E-mail ---
# Em desenvolvimento o Mailpit captura tudo: http://localhost:8025
# Em produção use o SMTP do seu provedor, ex.: smtps://usuario:senha@smtp.provedor.com:465
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Ritmo <nao-responda@ritmo.local>"
# Stack Docker (compose.yaml): sem valor, usa o Mailpit interno. Defina para enviar e-mails de verdade.
# SMTP_URL_DOCKER=smtps://usuario:senha@smtp.provedor.com:465
# Porta da interface do Mailpit na stack Docker (só em 127.0.0.1; acesse por túnel SSH na VPS).
# MAILPIT_UI_PORT=8026

# --- Dados sensíveis ---
# Chave AES-256 (32 bytes em base64) para a nota do check-in. Gere com: openssl rand -base64 32
# ATENÇÃO: trocar ou perder esta chave torna as notas já gravadas ilegíveis. Guarde-a com os backups.
DATA_ENCRYPTION_KEY=gere-com-openssl-rand-base64-32
